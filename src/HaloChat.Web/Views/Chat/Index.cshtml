@model List<HaloChat.Web.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "Danh sách người dùng";
}

<h1 class="hc-page-title">Danh sách người dùng</h1>

@if (Model.Count == 0)
{
    <div class="hc-empty-state">
        Chưa có người dùng nào khác. Mời bạn bè đăng ký để bắt đầu trò chuyện!
    </div>
}
else
{
    <ul id="user-list" class="list-group">
        @foreach (var user in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center" data-user-id="@user.Id">
                <a asp-action="Conversation" asp-route-id="@user.Id" class="hc-user-row">
                    <span class="hc-avatar">@user.DisplayName.Substring(0, 1).ToUpper()</span>
                    <span>@user.DisplayName</span>
                </a>
                <span class="presence-dot offline" title="offline">●</span>
            </li>
        }
    </ul>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
    <script src="~/js/chat.js"></script>
}
