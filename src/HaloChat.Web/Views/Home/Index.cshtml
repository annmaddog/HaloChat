@{
    ViewData["Title"] = "Trang chủ";
}

<div class="hc-hero">
    <img src="~/img/halochat-logo.png" alt="HaloChat" />
    <h1>Trò chuyện thời gian thực, sẵn sàng cho mã hóa</h1>
    <p class="lead">
        HaloChat là ứng dụng chat 1–1 với lịch sử tin nhắn, trạng thái online/offline
        thời gian thực, và kiến trúc mã hóa <code>IMessageCipher</code> sẵn sàng để cắm AES thật vào.
    </p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn hc-btn-primary btn-lg" asp-controller="Chat" asp-action="Index">Vào danh sách chat</a>
    }
    else
    {
        <a class="btn hc-btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">Đăng ký ngay</a>
        <a class="btn hc-btn-outline btn-lg" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
    }
</div>

<div class="hc-features">
    <div class="hc-feature-card">
        <h3>💬 Chat thời gian thực</h3>
        <p>Gửi/nhận tin nhắn tức thì qua SignalR, kèm trạng thái online/offline của người dùng.</p>
    </div>
    <div class="hc-feature-card">
        <h3>🗂️ Lưu lịch sử</h3>
        <p>Toàn bộ tin nhắn được lưu lại và hiển thị đầy đủ khi mở lại cuộc trò chuyện.</p>
    </div>
    <div class="hc-feature-card">
        <h3>🔒 Sẵn sàng cho AES</h3>
        <p>Tin nhắn đi qua interface mã hóa dùng chung, chỉ cần cắm cài đặt AES thật vào là xong.</p>
    </div>
</div>
