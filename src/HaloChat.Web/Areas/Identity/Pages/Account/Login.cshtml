@page
@model LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_AuthLayout";
}

<div class="hc-auth-card">
    <div class="hc-auth-form-pane hc-pane-left">
        <a href="/" class="hc-auth-logo">
            <img src="~/img/halochat-logo.png" alt="HaloChat" />
            <span><span class="hc-brand-halo">Halo</span><span class="hc-brand-chat">Chat</span></span>
        </a>

        <h1 class="hc-auth-title">Đăng nhập</h1>
        <p class="hc-auth-subtitle">Nhập tài khoản của bạn để tiếp tục trò chuyện</p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="hc-field">
                <label asp-for="Input.Email" class="hc-field-label">Email</label>
                <input asp-for="Input.Email" class="hc-field-input" autocomplete="username" aria-required="true" placeholder="ban@vidu.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="hc-field">
                <label asp-for="Input.Password" class="hc-field-label">Mật khẩu</label>
                <input asp-for="Input.Password" class="hc-field-input" autocomplete="current-password" aria-required="true" placeholder="Nhập mật khẩu" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="hc-auth-row">
                <label class="hc-checkbox">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    Ghi nhớ đăng nhập
                </label>
                <a id="forgot-password" asp-page="./ForgotPassword" class="hc-auth-link">Quên mật khẩu?</a>
            </div>

            <button id="login-submit" type="submit" class="hc-auth-submit">Đăng nhập</button>
        </form>
    </div>

    <div class="hc-auth-pitch-pane hc-pane-right">
        <div class="hc-auth-pitch-logo">
            <img src="~/img/halochat-logo.png" alt="HaloChat" />
        </div>
        <h2>Xin chào!</h2>
        <p>Chưa có tài khoản? Đăng ký chỉ mất một phút là có thể bắt đầu trò chuyện.</p>
        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="hc-auth-ghost-btn">Đăng ký</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
