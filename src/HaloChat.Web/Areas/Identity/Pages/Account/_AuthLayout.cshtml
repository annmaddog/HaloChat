<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HaloChat</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/img/halochat-logo.png" />
    <style>
        /* Hiệu ứng trượt ngang khi chuyển giữa Đăng nhập <-> Đăng ký (chỉ 2 trang này dùng layout riêng).
           Trượt 2D (translateX) — không dùng phối cảnh 3D để tránh lỗi render bo góc và đỡ rối mắt. */
        .hc-auth-card {
            animation: hc-fade-in 0.3s ease both;
        }

        @@keyframes hc-fade-in {
            from { opacity: 0; }
            to   { opacity: 1; }
        }

        .hc-auth-card.hc-slide-in-right {
            animation: hc-slide-in-right 0.38s ease both;
        }

        @@keyframes hc-slide-in-right {
            from { opacity: 0; transform: translateX(56px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        .hc-auth-card.hc-slide-in-left {
            animation: hc-slide-in-left 0.38s ease both;
        }

        @@keyframes hc-slide-in-left {
            from { opacity: 0; transform: translateX(-56px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        .hc-auth-card.hc-slide-out-left {
            animation: hc-slide-out-left 0.24s ease forwards;
        }

        @@keyframes hc-slide-out-left {
            from { opacity: 1; transform: translateX(0); }
            to   { opacity: 0; transform: translateX(-56px); }
        }

        .hc-auth-card.hc-slide-out-right {
            animation: hc-slide-out-right 0.24s ease forwards;
        }

        @@keyframes hc-slide-out-right {
            from { opacity: 1; transform: translateX(0); }
            to   { opacity: 0; transform: translateX(56px); }
        }
    </style>
</head>
<body class="hc-auth-body">
    <main class="hc-auth-shell">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var card = document.querySelector(".hc-auth-card");
            var toggleLink = document.querySelector(".hc-auth-ghost-btn");
            if (!card) {
                return;
            }

            // "forward" = Đăng nhập -> Đăng ký (trượt sang trái rồi trang mới trượt vào từ phải)
            // "backward" = Đăng ký -> Đăng nhập (ngược lại)
            var incomingDirection = sessionStorage.getItem("hc-auth-dir");
            sessionStorage.removeItem("hc-auth-dir");
            if (incomingDirection === "forward") {
                card.classList.add("hc-slide-in-right");
            } else if (incomingDirection === "backward") {
                card.classList.add("hc-slide-in-left");
            }

            if (toggleLink) {
                toggleLink.addEventListener("click", function (e) {
                    e.preventDefault();
                    var href = toggleLink.getAttribute("href");
                    var goingForward = card.dataset.authPage === "login";
                    sessionStorage.setItem("hc-auth-dir", goingForward ? "forward" : "backward");
                    card.classList.add(goingForward ? "hc-slide-out-left" : "hc-slide-out-right");
                    setTimeout(function () {
                        window.location.href = href;
                    }, 220);
                });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
