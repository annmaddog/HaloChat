<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HaloChat</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/img/halochat-logo.png" />
    <style>
        /* Thẻ trắng (form) và thẻ xanh (pitch) đổi chỗ cho nhau một cách mượt mà khi chuyển
           giữa Đăng nhập <-> Đăng ký, dùng View Transitions API của trình duyệt thay vì JS
           tự canh thời gian: trình duyệt tự "morph" từng thẻ từ vị trí cũ sang vị trí mới
           NGAY TRONG LÚC điều hướng — không có khoảng chờ, không có khoảng trắng, vì hiệu ứng
           là một phần của việc chuyển trang chứ không phải delay thêm vào trước khi chuyển.
           Trình duyệt chưa hỗ trợ (Firefox/Safari hiện tại) sẽ tự chuyển trang bình thường,
           không lỗi, chỉ là không có hiệu ứng. */
        @@view-transition {
            navigation: auto;
        }

        .hc-auth-form-pane {
            view-transition-name: hc-auth-form-pane;
        }

        .hc-auth-pitch-pane {
            view-transition-name: hc-auth-pitch-pane;
        }

        ::view-transition-group(hc-auth-form-pane),
        ::view-transition-group(hc-auth-pitch-pane) {
            animation-duration: 0.5s;
            animation-timing-function: ease-in-out;
        }
    </style>
</head>
<body class="hc-auth-body">
    <main class="hc-auth-shell">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
