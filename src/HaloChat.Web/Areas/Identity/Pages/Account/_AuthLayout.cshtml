<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HaloChat</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/img/halochat-logo.png" />
    <style>
        /* Hiệu ứng lật thẻ khi chuyển giữa Đăng nhập <-> Đăng ký (chỉ 2 trang này dùng layout riêng).
           Thuần CSS + JS nhỏ, chạy được trên mọi trình duyệt (không phụ thuộc View Transitions API). */
        .hc-auth-card {
            animation: hc-flip-in 0.45s ease both;
        }

        @@keyframes hc-flip-in {
            from { opacity: 0; transform: perspective(1400px) rotateY(-14deg) scale(0.96); }
            to   { opacity: 1; transform: perspective(1400px) rotateY(0deg) scale(1); }
        }

        .hc-auth-card.hc-flip-out {
            animation: hc-flip-out 0.32s ease forwards;
        }

        @@keyframes hc-flip-out {
            from { opacity: 1; transform: perspective(1400px) rotateY(0deg) scale(1); }
            to   { opacity: 0; transform: perspective(1400px) rotateY(14deg) scale(0.96); }
        }
    </style>
</head>
<body class="hc-auth-body">
    <main class="hc-auth-shell">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var card = document.querySelector(".hc-auth-card");
            var toggleLink = document.querySelector(".hc-auth-ghost-btn");
            if (!card || !toggleLink) {
                return;
            }
            toggleLink.addEventListener("click", function (e) {
                e.preventDefault();
                var href = toggleLink.getAttribute("href");
                card.classList.add("hc-flip-out");
                setTimeout(function () {
                    window.location.href = href;
                }, 300);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
