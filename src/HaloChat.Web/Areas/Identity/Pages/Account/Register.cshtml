@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_AuthLayout";
}

<div class="hc-auth-card">
    <div class="hc-auth-pitch-pane hc-pane-left">
        <div class="hc-auth-pitch-logo">
            <img src="~/img/halochat-logo.png" alt="HaloChat" />
        </div>
        <h2>Chào mừng đến với HaloChat!</h2>
        <p>Đã có tài khoản? Đăng nhập để tiếp tục các cuộc trò chuyện của bạn.</p>
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="hc-auth-ghost-btn">Đăng nhập</a>
    </div>

    <div class="hc-auth-form-pane hc-pane-right">
        <a href="/" class="hc-auth-logo">
            <img src="~/img/halochat-logo.png" alt="HaloChat" />
            <span><span class="hc-brand-halo">Halo</span><span class="hc-brand-chat">Chat</span></span>
        </a>

        <h1 class="hc-auth-title">Tạo tài khoản</h1>
        <p class="hc-auth-subtitle">Đăng ký để bắt đầu trò chuyện trên HaloChat</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="hc-field">
                <label asp-for="Input.Email" class="hc-field-label">Email</label>
                <input asp-for="Input.Email" class="hc-field-input" autocomplete="username" aria-required="true" placeholder="ban@vidu.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="hc-field">
                <label asp-for="Input.Password" class="hc-field-label">Mật khẩu</label>
                <input asp-for="Input.Password" class="hc-field-input" autocomplete="new-password" aria-required="true" placeholder="Tối thiểu 6 ký tự" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="hc-field">
                <label asp-for="Input.ConfirmPassword" class="hc-field-label">Nhập lại mật khẩu</label>
                <input asp-for="Input.ConfirmPassword" class="hc-field-input" autocomplete="new-password" aria-required="true" placeholder="Nhập lại mật khẩu" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="hc-auth-submit">Đăng ký</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
